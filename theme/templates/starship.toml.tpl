# GENERATED by theme/generate.py from theme/palette.toml. Edit the template, not this file.
"$schema" = 'https://starship.rs/config-schema.json'

format = """
[]({{violet}})\
$os\
$username\
[](bg:{{red}} fg:{{violet}})\
$directory\
[](fg:{{red}} bg:{{bright_yellow}})\
$git_branch\
$git_status\
[](fg:{{bright_yellow}} bg:{{bright_cyan}})\
$c\
$elixir\
$elm\
$golang\
$gradle\
$haskell\
$java\
$julia\
$maven\
$nodejs\
$bun\
$nim\
$rust\
$scala\
[](fg:{{bright_cyan}} bg:{{bright_green}})\
$docker_context\
[](fg:{{bright_green}} bg:{{raised}})\
$time\
[ ](fg:{{raised}})\
$line_break\
$character\
"""

# Second line: a neon prompt arrow (yellow = ok, pink = last command failed).
[character]
success_symbol = "[❯](bold {{bright_yellow}})"
error_symbol = "[❯](bold {{red}})"


# You can also replace your username with a neat symbol like   or disable this
# and use the os module below
[username]
show_always = true
style_user = "bg:{{violet}} fg:{{background}}"
style_root = "bg:{{violet}} fg:{{background}}"
format = '[$user ]($style)'
disabled = false

# An alternative to the username module which displays a symbol that
# represents the current operating system
[os]
style = "bg:{{violet}} fg:{{background}}"
disabled = true # Disabled by default

[directory]
style = "bg:{{red}} fg:{{background}}"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

# Here is how you can shorten some long paths by text replacement
# similar to mapped_locations in Oh My Posh:
[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = " "
"Pictures" = " "
# Keep in mind that the order matters. For example:
# "Important Documents" = " 󰈙 "
# will not be replaced, because "Documents" was already substituted before.
# So either put "Important Documents" before "Documents" or use the substituted version:
# "Important 󰈙 " = " 󰈙 "

[c]
symbol = " "
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[cpp]
symbol = " "
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[docker_context]
symbol = " "
style = "bg:{{bright_green}} fg:{{background}}"
format = '[ $symbol $context ]($style)'

[elixir]
symbol = " "
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[elm]
symbol = " "
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[git_branch]
symbol = ""
style = "bg:{{bright_yellow}} fg:{{background}}"
format = '[ $symbol $branch ]($style)'

[git_status]
style = "bg:{{bright_yellow}} fg:{{background}}"
format = '[$all_status$ahead_behind ]($style)'

[golang]
symbol = " "
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[gradle]
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[haskell]
symbol = " "
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[java]
symbol = " "
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[julia]
symbol = " "
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[maven]
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[nodejs]
symbol = ""
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[bun]
symbol = ""
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[nim]
symbol = "󰆥 "
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[rust]
symbol = ""
style = "bg:{{bright_cyan}} fg:{{background}}"
format = '[ $symbol ($version) ]($style)'

[scala]
