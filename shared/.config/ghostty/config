# Ghostty config shared between Omarchy (Linux) and macOS.
# Theme: Cyberpunk: Edgerunners (palette in theme/palette.toml).
# Machine-specific settings go in local.conf (loaded last, optional).

# Font
font-family = "Hack Nerd Font Mono"
font-size = 10

# macOS: Option acts as Alt (tmux Alt shortcuts); ignored on Linux.
macos-option-as-alt = true

# Colors live in theme.conf (generated from theme/palette.toml).
config-file = theme.conf

# Window
background-opacity = 0.88
background-blur = 20
window-padding-x = 12
window-padding-y = 10
confirm-close-surface = false
resize-overlay = never

# Cursor
cursor-style = block
cursor-style-blink = false

# Bell (backspace on an empty line, etc.): flash a border around the window.
bell-features = border,attention

# Keys: send CSI-u so TUIs and tmux can tell these apart (tmux M-S-Enter).
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u

config-file = ?"~/.config/ghostty/local.conf"
