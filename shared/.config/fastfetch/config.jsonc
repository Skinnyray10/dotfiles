// Cyberpunk: Edgerunners greeting. Shown by ~/.config/shell/tools.sh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": { "1": "38;2;252;238;10", "2": "38;2;0;240;255" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;176;38;255", "title": "38;2;255;42;109", "output": "38;2;217;246;255" }
  },
  "modules": [
    "title",
    "break",
    { "type": "os",       "key": "os   " },
    { "type": "kernel",   "key": "kern " },
    { "type": "uptime",   "key": "up   " },
    { "type": "shell",    "key": "sh   " },
    { "type": "terminal", "key": "term " },
    { "type": "memory",   "key": "mem  " },
    { "type": "disk",     "key": "disk ", "folders": "/" },
    "break",
    "colors"
  ]
}
