# Backups made by install.sh and Omarchy
*.bak
*.bak.*
# macOS
.DS_Store
# Machine-specific or private files that must never be committed
config.local
*.local
.env

# Wallpapers (copyrighted fan art must not go in a public repo). Put your own in
# ~/.config/omarchy/backgrounds/<theme-slug>/ instead.
omarchy/.config/omarchy/themes/*/backgrounds/
# ...but keep the ~/.local folder package (scripts live in shared/.local/bin)
!.local
